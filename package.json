{
  "name": "basin-masasi",
  "version": "0.4.2",
  "description": "İl/İlçe Millî Eğitim Müdürlükleri için yapay zekâ destekli haber metni yazım uygulaması",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js",
    "test": "node --test",
    "dist:win": "electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trend7Mark/emre.git"
  },
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/Trend7Mark/emre/issues"
  },
  "homepage": "https://github.com/Trend7Mark/emre#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "electron-updater": "6.8.9",
    "express": "^4.22.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "productName": "Basın Masası",
  "build": {
    "appId": "tr.gov.meb.basinmasasi",
    "productName": "Basın Masası",
    "artifactName": "BasinMasasi-${version}-${arch}-${name}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Basın Masası",
      "artifactName": "BasinMasasi-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BasinMasasi-Tasinabilir-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Trend7Mark",
        "repo": "emre"
      }
    ]
  }
}
