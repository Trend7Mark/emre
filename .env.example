# Yapay zekâ sağlayıcısı: claude | gemini | demo
#   demo: anahtar gerektirmez, sahte çıktı üretir (arayüzü denemek için)
AI_PROVIDER=claude

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Sunucu
PORT=3000
# Verilerin (ayarlar, örnek haberler, arşiv) tutulacağı klasör
DATA_DIR=./data
